{
  "name": "URL Parser",
  "short_name": "URL Parser",
  "description": "Paste a URL and see the protocol, host, port, path segments, every query parameter and the fragment. Percent-encoding is decoded and duplicate keys stay apart.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#7c3aed",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
