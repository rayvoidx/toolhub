{
  "name": "XML Formatter",
  "short_name": "XML Formatter",
  "description": "Paste XML to pretty-print it with 2-space, 4-space or tab indentation, minify it to one line, or validate it and see the exact error line. CDATA, comments and the XML declaration are preserved. Runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#7c3aed",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
