{
  "name": "JSON to CSV Converter",
  "short_name": "JSON to CSV",
  "description": "Paste a JSON array of objects and get a clean CSV instantly — nested objects flattened to dot-notation columns, proper RFC 4180 quoting, comma/semicolon/tab delimiters. Free, private, runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#15803d",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
