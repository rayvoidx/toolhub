{
  "name": "Matrix Calculator",
  "short_name": "Matrix Calculator",
  "description": "Multiply, add, subtract, transpose or invert 2x2 and 3x3 matrices in your browser. Every answer shows the determinant and the arithmetic behind the first entry.",
