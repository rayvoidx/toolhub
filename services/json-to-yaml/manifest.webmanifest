{
  "name": "JSON to YAML Converter",
  "short_name": "JSON to YAML Converter",
  "description": "Convert JSON to YAML online in your browser. Paste any JSON object, choose 2 or 4 space indent, and copy clean YAML with safe 1.2 style quoting.",
