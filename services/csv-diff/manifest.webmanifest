{
  "name": "CSV Diff — Compare Two Files by Key",
  "short_name": "CSV Diff — Compare Two Files by Key",
  "description": "Free browser-only tool to compare two CSV files or pasted spreadsheets by a key column (ID, email, SKU). Get added, removed, changed and unchanged rows with the changed cells highlighted old to new, plus per-tab CSV export. A key-join diff (not a text-line diff), so it stays accurate even when row and column order differ. Locale-aware compare (dates, thousands separators, leading zeros) removes false changes. Your files never leave the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#164e63",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
