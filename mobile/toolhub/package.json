{
  "name": "toolhub-pocket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180",
    "test": "node --test tests/*.test.mjs",
    "web": "node scripts/build.mjs web",
    "bundle": "node scripts/build.mjs native",
    "sync": "npm run bundle && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/app": "^8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^7.3.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
